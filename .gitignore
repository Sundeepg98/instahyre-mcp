# Local state -- session cookies, cached payloads, the job index, the browser
# profile. None of this belongs in git, and the session file holds live
# credentials-equivalent cookies.
_state/
*.db
session.json
browser_profile/

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Scratch
*.log

# Environment files -- never commit. Secrets land in .env by default, and a
# tracked .env means the next key added to it commits without anyone noticing.
.env
.env.*
!.env.example

# Raw browser captures. Scrubbed, but they are page dumps and analytics URLs
# carrying tracking identifiers -- the distilled, guarded contracts live in
# tests/fixtures/write_contracts/ instead.
_audit/_data/
